---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import PageHeader from '../components/PageHeader.astro';
import { getPage } from '../lib/sanity';

const page = await getPage('contact');
---

<Layout
  title={page?.seo?.metaTitle ?? 'Contact // Sitwell Cycling Club'}
  description={page?.seo?.metaDescription ?? 'Founded 2016. Rotherham Advertiser Sports Awards Club of the Year 2018. 10 social rides a week. Go-Ride Coaching. Meet Brookside Pharmacy, Whiston.'}
  socialImage={page?.seo?.socialImage}
>
  <PageHeader page={page} title="Get in touch" subtitle="We love cycling">
    <p class="lg:w-3/4">We aim to respond to all enquiries as soon as possible, but there might be a slight delay if the weather is good.</p>
  </PageHeader>
  <section class="w-full px-5 lg:px-10 mb-5 grid lg:grid-cols-3 lg:gap-5">
    <section class="lg:col-span-2 mb-5">
      <ContactForm client:load />
    </section>
    <section class="lg:col-span-2">
      <h3 class="text-xl font-ropa mb-1">Follow us on the socials</h3>
      <ul class="flex mb-10">
        <li>
          <a href="https://www.instgram.com/sitwellcc" class="inline-block mr-2.5">
            <img src="/img/instagram.svg" alt="Instagram icon" width="40" height="40" />
          </a>
        </li>
        <li>
          <a href="https://www.twitter.com/sitwellcc" class="inline-block mr-2.5">
            <img src="/img/twitter.svg" alt="Twitter icon" width="40" height="40" />
          </a>
        </li>
        <li>
          <a href="https://www.strava.com/sitwellcc" class="inline-block mr-2.5">
            <img src="/img/strava.svg" alt="Strava icon" width="40" height="40" />
          </a>
        </li>
        <li>
          <a href="https://www.facebook.com/sitwellcc">
            <img src="/img/facebook.svg" alt="Facebook icon" width="40" height="40" />
          </a>
        </li>
      </ul>
    </section>
  </section>

  <section class="w-full px-5 lg:px-10 mb-20 grid lg:grid-cols-3 lg:gap-5">
    <section class="mb-10 md:mb-0">
      <h3 class="text-xl font-ropa">Club ride meet point</h3>
      <p class="text-sm mb-2.5">Brookside Pharmacy, Whiston, S60 4HY</p>
      <iframe
        title="Map of the club ride meet point at Brookside Pharmacy, Whiston"
        src="https://www.openstreetmap.org/export/embed.html?bbox=-1.333854,53.401345,-1.321854,53.409345&layer=mapnik&marker=53.405345,-1.327854"
        height="250"
        style="border: 0;"
        loading="lazy"
        class="w-full"></iframe>
    </section>
    <section>
      <h3 class="text-xl font-ropa">Go-Ride coaching meet point</h3>
      <p class="text-sm mb-2.5">Herringthorpe Playing Fields, S65 2HR</p>
      <iframe
        title="Map of the Go-Ride coaching meet point at Herringthorpe Playing Fields"
        src="https://www.openstreetmap.org/export/embed.html?bbox=-1.344543,53.418375,-1.332543,53.426375&layer=mapnik&marker=53.422375,-1.338543"
        height="250"
        style="border: 0;"
        loading="lazy"
        class="w-full"></iframe>
    </section>
  </section>
</Layout>
