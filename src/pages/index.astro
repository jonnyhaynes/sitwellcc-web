---
import Layout from '../layouts/Layout.astro';
import groq from 'groq';
import SanityImage from '../components/SanityImage.astro';
import { client, getPage, featureFor } from '../lib/sanity';
import type { Feature, FeatureKey } from '../lib/sanity';

type NewsItem = {
  _id: string;
  title?: string;
  slug?: { current: string };
  summary?: string;
};

const announcement = await client.fetch<NewsItem>(
  groq`*[_type == "post" && publishedAt <= now() && announcement == true] | order(publishedAt desc) [0]`,
);
const news = await client.fetch<NewsItem[]>(
  groq`*[_type == "post" && publishedAt <= now() && announcement != true] | order(publishedAt desc) [0...3]`,
);

// Crop a summary to its first sentence (up to and including the first full stop).
const firstSentence = (text = '') => {
  const end = text.indexOf('.');
  return end === -1 ? text : text.slice(0, end + 1);
};

const page = await getPage('home');

// The four promo cards. Layout per card stays in the markup below — only the
// content is CMS-driven, matched by key. These defaults reproduce what the page
// shipped with, so nothing changes until a `home` doc is authored.
//
// The \u00A0 escapes below are non-breaking spaces, written as escapes so they
// are visible in review. They reproduce the `&nbsp;` entities the markup used,
// keeping the last words of a heading together instead of letting one dangle.
const CARD_DEFAULTS: Record<FeatureKey, Omit<Feature, 'key' | 'image'> & { fallbackSrc: string; fallbackAlt: string }> = {
  rides: {
    eyebrow: 'Club rides',
    heading: "We're here for the smiles, not\u00A0the\u00A0miles.",
    body: 'Ten social rides a week on Wednesday evenings, and Saturday and Sunday mornings.',
    linkHref: '/rides',
    linkLabel: 'Find out more',
    fallbackSrc: '/img/rides.webp',
    fallbackAlt:
      'A landscape photograph of a sunset over Whiston with two Club riders up front',
  },
  charity: {
    eyebrow: 'Charity work',
    heading: 'We raise vital funds for\u00A0local\u00A0charities',
    body: 'In 2019 we raised over £12,250 for Rotherham Hospice through a range of activities.',
    linkHref: '/charity',
    linkLabel: 'Find out more',
    fallbackSrc: '/img/charity.webp',
    fallbackAlt: 'A landscape photograph of Club members at Rotherham Hospice',
  },
  races: {
    eyebrow: 'Races',
    // Three stacked lines. Authored in Sanity as a multi-line text field and
    // rendered with `whitespace-pre-line`, so no markup comes out of the CMS.
    heading: 'We host races.\nWe support races.\nWe race.',
    body: 'Up hills, down hills, round tracks, circuits, and off road.',
    linkHref: '/races',
    linkLabel: 'Find out more',
    fallbackSrc: '/img/racing.webp',
    fallbackAlt: 'A photograph of Club member Joe Srike racing up Ulley Lane',
  },
  coaching: {
    eyebrow: 'Go-ride coaching',
    heading: "We're coaching the\u00A0next\u00A0generation.",
    body: 'Our Saturday morning sessions are suitable for under 16s.',
    linkHref: '/coaching',
    linkLabel: 'Find out more',
    fallbackSrc: '/img/coaching.webp',
    fallbackAlt:
      'A photograph of our Go-Ride coaching group listneing to intructions from a mix of club coaches',
  },
};

// Merge the CMS card (if any) over the built-in defaults, field by field, so a
// half-filled card in the Studio still renders complete.
const card = (key: FeatureKey) => {
  const cms = featureFor(page, key);
  const base = CARD_DEFAULTS[key];
  return {
    image: cms?.image ?? null,
    eyebrow: cms?.eyebrow ?? base.eyebrow,
    heading: cms?.heading ?? base.heading,
    body: cms?.body ?? base.body,
    linkHref: cms?.linkHref ?? base.linkHref,
    linkLabel: cms?.linkLabel ?? base.linkLabel,
    fallbackSrc: base.fallbackSrc,
    fallbackAlt: base.fallbackAlt,
  };
};

const rides = card('rides');
const charity = card('charity');
const races = card('races');
const coaching = card('coaching');
---

<Layout
  title="Sitwell Cycling Club"
  description="Founded 2016. Rotherham Advertiser Sports Awards Club of the Year 2018. 10 social rides a week. Go-Ride Coaching. Meet Brookside Pharmacy, Whiston."
>
  <section class="updates grid gap-5 lg:grid-cols-4 px-5 lg:px-10 mb-20">
    <section class="announcements">
      <h3 class="w-full border-b-8 border-green mb-5 lg:mr-10"><span class="inline-block bg-green text-yellow text-md font-ropa uppercase pt-2 px-3">Announcements</span></h3>
      {announcement?.slug && (
        <article>
          <h2 class="text-3xl font-ropa-bold"><a href={`/news/${announcement.slug.current}`} class="text-black">{announcement.title}</a></h2>
          <p class="opacity-75">{firstSentence(announcement.summary)}</p>
        </article>
      )}
    </section>
    <section class="news lg:col-span-3">
      <h3 class="w-full border-b-8 border-yellow mb-5"><span class="inline-block bg-yellow text-green text-md font-ropa uppercase pt-2 px-3">Don&apos;t miss this</span></h3>
      <div class="grid gap-5 md:grid-cols-3">
        {news?.map((item) => item.slug && (
          <article>
            <h2 class="text-3xl font-ropa-bold"><a href={`/news/${item.slug.current}`} class="text-black">{item.title}</a></h2>
            <p class="opacity-75">{firstSentence(item.summary)}</p>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section class="media flex flex-row w-full flex-wrap px-5 lg:px-10 mb-10">
    <article class="club-rides block relative w-full lg:w-7/12 lg:pr-5 mb-10 h-96">
      <a href={rides.linkHref} class="block w-full h-full overflow-hidden relative">
        <SanityImage
          image={rides.image}
          width={1400}
          height={768}
          fallbackSrc={rides.fallbackSrc}
          fallbackAlt={rides.fallbackAlt}
          class="absolute inset-0 object-cover object-right w-full h-full"
          loading="eager"
        />
        <div class="absolute left-0 bottom-0 text-white p-5">
          <h3 class="font-ropa text-lg uppercase">{rides.eyebrow}</h3>
          <h2 class="font-ropa text-3xl whitespace-pre-line">{rides.heading}</h2>
          <p>{rides.body}</p>
        </div>
        <button class="btn absolute top-5 left-5" aria-label={rides.linkLabel}>{rides.linkLabel}</button>
      </a>
    </article>
    <article class="charity block relative w-full lg:w-5/12 lg:pl-5 mb-10 h-96">
      <a href={charity.linkHref} class="block w-full h-full overflow-hidden relative">
        <SanityImage
          image={charity.image}
          width={1000}
          height={768}
          fallbackSrc={charity.fallbackSrc}
          fallbackAlt={charity.fallbackAlt}
          class="absolute inset-0 object-cover object-right w-full h-full"
          loading="eager"
        />
        <div class="absolute bottom-0 left-0 text-white p-5">
          <h3 class="font-ropa text-lg uppercase">{charity.eyebrow}</h3>
          <h2 class="font-ropa text-3xl whitespace-pre-line">{charity.heading}</h2>
          <p>{charity.body}</p>
        </div>
        <button class="btn absolute top-5 right-5" aria-label={charity.linkLabel}>{charity.linkLabel}</button>
      </a>
    </article>
    <article class="races block relative w-full lg:w-5/12 lg:pr-5 mb-10 h-96">
      <a href={races.linkHref} class="block w-full h-full overflow-hidden relative">
        <SanityImage
          image={races.image}
          width={1000}
          height={768}
          fallbackSrc={races.fallbackSrc}
          fallbackAlt={races.fallbackAlt}
          class="absolute inset-0 object-cover object-right w-full h-full"
          loading="eager"
        />
        <div class="absolute top-0 right-0 text-white text-right p-5 flex flex-col items-end">
          <h3 class="font-ropa text-lg uppercase">{races.eyebrow}</h3>
          <h2 class="font-ropa text-3xl whitespace-pre-line">{races.heading}</h2>
          <p class="w-3/5 lg:w-2/5 mb-2.5 self-end">{races.body}</p>
          {/* Brand mark, not editorial content — stays in the repo. */}
          <img src="/img/epic-kitemark--white.webp" alt="Equality and Parity In Cycling" width="40" height="55" />
        </div>
        <button class="btn absolute right-5 bottom-5" aria-label={races.linkLabel}>{races.linkLabel}</button>
      </a>
    </article>
    <article class="coaching block relative w-full lg:w-7/12 lg:pl-5 mb-10 h-96">
      <a href={coaching.linkHref} class="block w-full h-full overflow-hidden relative">
        <SanityImage
          image={coaching.image}
          width={1400}
          height={768}
          fallbackSrc={coaching.fallbackSrc}
          fallbackAlt={coaching.fallbackAlt}
          class="absolute inset-0 object-cover w-full h-full"
          loading="eager"
        />
        <div class="absolute bottom-0 left-0 text-white p-5">
          <h3 class="font-ropa text-lg uppercase">{coaching.eyebrow}</h3>
          <h2 class="font-ropa text-3xl whitespace-pre-line">{coaching.heading}</h2>
          <p>{coaching.body}</p>
        </div>
        <button class="btn absolute right-5 bottom-5" aria-label={coaching.linkLabel}>{coaching.linkLabel}</button>
      </a>
    </article>
  </section>
</Layout>
