---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SanityImage from '../components/SanityImage.astro';
import { getPage } from '../lib/sanity';

const page = await getPage('membership');

// The grid puts four photos above the pricing block and the rest below it. The
// hard-coded filenames are the fallback for each slot, so the page looks
// identical until a `gallery` is authored — and the slot count stays fixed at
// 4 + 8 regardless of how many photos the editor uploads.
const FALLBACKS_ABOVE = ['zero', 'one', 'two', 'three'];
const FALLBACKS_BELOW = ['four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven'];

const gallery = page?.gallery ?? [];
const above = FALLBACKS_ABOVE.map((name, i) => ({
  image: gallery[i] ?? null,
  fallbackSrc: `/img/membership/${name}.webp`,
}));
const below = FALLBACKS_BELOW.map((name, i) => ({
  image: gallery[FALLBACKS_ABOVE.length + i] ?? null,
  fallbackSrc: `/img/membership/${name}.webp`,
}));
---
<Layout
    title={page?.seo?.metaTitle ?? 'Membership // Sitwell Cycling Club'}
    description={page?.seo?.metaDescription ?? 'For the good times!'}
    socialImage={page?.seo?.socialImage}
>
    <PageHeader page={page} title="Membership" subtitle="For the good times!">
        <p class="lg:w-3/4">You&apos;re more than welcome to come along for a couple of rides before deciding if we&apos;re the club for you, but we think our membership is great value for money. Membership runs January - December, and if you join from October onwards you&apos;ll be credited with the following year. Benefits include discounts on bike servicing and parts, bike fits, sports nutrition, bike insurance, and skincare, as well as access to club kit, socials and awards amongst a whole host of other things. First year members receive a club branded buff, stickers and <a href="https://onelifeid.com/">OneLifeiD</a> tags.</p>
    </PageHeader>
    <section class="membership w-full px-5 lg:px-10 mb-20 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {above.map((slot) => (
            <SanityImage
                image={slot.image}
                width={285}
                height={285}
                fallbackSrc={slot.fallbackSrc}
                fallbackAlt="A photograph of members"
                class="block w-full"
                loading="eager"
            />
        ))}
        <section class="md:col-span-2 lg:col-span-4 grid gap-5 md:grid-cols-5">
            <div class="md:py-5 flex">
                <div class="bg-yellow/25 p-5 w-full flex flex-col content-center justify-center">
                    <h3 class="text-base font-ropa block uppercase opacity-50">0-11</h3>
                    <h2 class="text-2xl font-ropa">Under 12</h2>
                    <h3 class="text-large font-ropa block uppercase opacity-75">£5</h3>
                    <p class="text-xs">Go-Ride Coaching</p>
                    <p class="text-xs mb-5"><del>Club rides</del></p>
                    <a class="btn self-start" href="https://www.britishcycling.org.uk/club/subscriptions/buy?club_id=7596&subscription_id=2962">Buy now</a>
                </div>
            </div>
            <div class="md:py-5 flex">
                <div class="bg-yellow/25 p-5 w-full flex flex-col content-center justify-center">
                    <h3 class="text-base font-ropa block uppercase opacity-50">12-15</h3>
                    <h2 class="text-2xl font-ropa">Youth</h2>
                    <h3 class="text-large font-ropa block uppercase opacity-75">£10</h3>
                    <p class="text-xs">Go-Ride Coaching</p>
                    <p class="text-xs mb-5">Club rides with parent/guardian</p>
                    <a class="btn self-start" href="https://www.britishcycling.org.uk/club/subscriptions/buy?club_id=7596&subscription_id=2961">Buy now</a>
                </div>
            </div>
            <div class="md:py-5 flex">
                <div class="bg-yellow/25 p-5 w-full flex flex-col content-center justify-center">
                    <h3 class="text-base font-ropa block uppercase opacity-50">16-17</h3>
                    <h2 class="text-2xl font-ropa">Junior</h2>
                    <h3 class="text-large font-ropa block uppercase opacity-75">£15</h3>
                    <p class="text-xs"><del>Go-Ride Coaching</del></p>
                    <p class="text-xs mb-5">Club rides with parent/guardian</p>
                    <a class="btn self-start" href="https://www.britishcycling.org.uk/club/subscriptions/buy?club_id=7596&subscription_id=2930">Buy now</a>
                </div>
            </div>
            <div class="flex">
                <div class="bg-green/25 p-5 w-full flex flex-col content-center justify-center">
                    <h3 class="text-base font-ropa block uppercase opacity-50">18+</h3>
                    <h2 class="text-2xl font-ropa">Adult</h2>
                    <h3 class="text-large font-ropa block uppercase opacity-75">£20</h3>
                    <p class="text-xs"><del>Go-Ride Coaching</del></p>
                    <p class="text-xs mb-5">Club rides</p>
                    <a class="btn self-start" href="https://www.britishcycling.org.uk/club/subscriptions/buy?club_id=7596&subscription_id=1558">Buy now</a>
                </div>
            </div>
            <div class="md:py-5 flex">
                <div class="bg-yellow/25 p-5 w-full flex flex-col content-center justify-center">
                    <h3 class="text-base font-ropa block uppercase opacity-50">0+</h3>
                    <h2 class="text-2xl font-ropa">Volunteer</h2>
                    <h3 class="text-large font-ropa block uppercase opacity-75">£5</h3>
                    <p class="text-xs"><del>Go-Ride Coaching</del></p>
                    <p class="text-xs mb-5"><del>Club rides</del></p>
                    <a class="btn self-start" href="https://www.britishcycling.org.uk/club/subscriptions/buy?club_id=7596&subscription_id=2964">Buy now</a>
                </div>
            </div>
        </section>
        <p class="md:col-span-2 lg:col-span-4 text-center text-xs opacity-50">*All membership is subject to a £1 processing fee by British Cycling</p>
        {below.map((slot) => (
            <SanityImage
                image={slot.image}
                width={285}
                height={285}
                fallbackSrc={slot.fallbackSrc}
                fallbackAlt="A photograph of members"
                class="block w-full"
            />
        ))}
    </section>
</Layout>
