---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';
import {
  getPage,
  getEvents,
  upcomingEvents,
  eventMonthLabel,
} from '../lib/sanity';

const page = await getPage('races');
const authored = await getEvents();

// One "now" for the whole page, so the filter and the month labels can't
// disagree with each other across a build that straddles midnight.
const now = new Date();
const events = upcomingEvents(authored, now);

// Three states, deliberately distinct:
//  - nothing authored yet -> keep the card built into the page, so merging this
//    changes nothing on the live site (same fallback pattern as every other
//    phase of the CMS work). It goes away the moment an event is published.
//  - events authored, none upcoming -> say so. Falling back to the built-in card
//    here would resurrect a race that has already happened.
//  - events upcoming -> render them.
const showBuiltInCard = authored.length === 0;
---

<Layout
  title={page?.seo?.metaTitle ?? 'Races // Sitwell Cycling Club'}
  description={page?.seo?.metaDescription ?? 'We host races. We support races. We race.'}
  socialImage={page?.seo?.socialImage}
>
  <PageHeader page={page} title="Races" subtitle="We host races. We support races. We race.">
    <p class="lg:w-3/4">Up hills, down hills, round tracks, circuits, and off road. We&apos;ve even had our stripes represented at National Championships. Throughout the year we host a handful of races, across multiple disciplines and age groups. Our members also support grassroots and national level races through the <a href="https://www.britishcycling.org.uk/accreditedmarshal">British Cycling Accredited Marshal Scheme</a>, as well as just being an extra pair of hands when required. <em>All of our races are <a href="https://epic-group.org/">EPiC Kitemark</a> certified</em>.</p>
  </PageHeader>
  <section class="races w-full px-5 lg:px-10 mb-20 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
    {events.map((event) => (
      <EventCard event={event} monthLabel={eventMonthLabel(event.date, now)} />
    ))}
    {showBuiltInCard && (
      <div class="border-t-8 border-amber pt-5">
        <a href="https://www.britishcycling.org.uk/events/details/326708/Ranskill-Gold-2025---Ride-of-the-Falling-Leaves-Edition" class="relative block w-full mb-5">
          <img src="/img/ranskill.webp" class="block w-full" alt="A photograph of members at Ranskill" width="285" height="285" />
          <img src="/img/bc.webp" class="absolute bottom-5 right-5" alt="The British Cycling logo" width="88" height="50" />
          <span class="btn absolute top-5 left-5">Enter now</span>
        </a>
        <h3 class="text-base font-ropa block uppercase opacity-50">October</h3>
        <h2 class="text-2xl font-ropa text-amber">Ranskill Gold - Ride of the Falling Leaves Edition</h2>
        <p class="text-sm mb-2">Three routes to choose from (40/60/80 miles) using familiar roads out east. Money raised goes to Bluebell Wood Children&apos;s Hospice.</p>
        <p class="text-sm mb-1">Sign on: <strong>Ulley Village Hall, S26 3YD</strong></p>
        <p class="text-sm mb-2">Fee: <strong>£10</strong></p>
      </div>
    )}
    {!showBuiltInCard && events.length === 0 && (
      <p class="md:col-span-2 lg:col-span-4">We haven&apos;t got any races or club events in the diary at the moment. They tend to be announced a few months ahead, so it&apos;s worth checking back — or <a href="/contact">get in touch</a> if you&apos;d like to help us put one on.</p>
    )}
  </section>
</Layout>
